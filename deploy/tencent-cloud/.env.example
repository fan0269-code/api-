# Tencent Cloud CVM Docker Compose variables.
# Copy this file to deploy/tencent-cloud/.env and fill in real values.

DEPLOY_HOST=your.server.ip
DEPLOY_USER=ubuntu
DEPLOY_PATH=/var/www/api-relay-console
DEPLOY_KEY=$HOME/.ssh/tencent-cloud.pem

SUB2API_BIND_HOST=127.0.0.1
SUB2API_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=sub2api

REDIS_PASSWORD=replace-with-a-long-random-redis-password

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_SECRET=replace-with-64-hex-or-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-64-hex-or-long-random-secret

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
UPDATE_PROXY_URL=
