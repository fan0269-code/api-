# Tencent Cloud CVM deployment variables.
# Copy this file to deploy/tencent-cloud/.env.local and fill in real values.

DEPLOY_HOST=your.server.ip
DEPLOY_USER=ubuntu
DEPLOY_PATH=/var/www/api-relay-console
APP_PORT=8787

# Console management API session token.
RELAY_ADMIN_TOKEN=replace-with-a-long-random-console-token

# Optional OpenAI-compatible upstream for /v1/chat/completions.
# Leave empty to use the built-in mock response mode.
RELAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
RELAY_UPSTREAM_API_KEY=sk-your-upstream-key

# Optional when your key is already loaded in ssh-agent.
DEPLOY_KEY=$HOME/.ssh/tencent-cloud.pem
